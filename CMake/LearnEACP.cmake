# Where this file is, for the functions below: a function's
# CMAKE_CURRENT_LIST_DIR is its caller's.
set(LEARNEACP_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}")

# learneacp_add_chapter([CONSOLE] [LIBRARIES <target>...])
#
# Called from a chapter's CMakeLists.txt, in a directory named NN-Name. Builds
# the chapter twice from its Main.cpp:
#
# - <Name>, the standalone app, where LEARNEACP_CHAPTER(View) is main(). A
#   macOS bundle with EACP's default settings, and a GUI app on Windows unless
#   CONSOLE is given (a console chapter keeps its console output there).
# - <Name>Chapter, an object library compiled with LEARNEACP_CHAPTER_REGISTRY,
#   where the same macro registers the chapter instead. Its name is appended to
#   the global property LEARNEACP_CHAPTER_LIBRARIES, in chapter order, so a
#   program that links them all can list every chapter. Linking the object
#   files directly (rather than through a static library) keeps every
#   registration in the final program.
#
# LIBRARIES are linked into both, on top of eacp-gpu.
function(learneacp_add_chapter)
    cmake_parse_arguments(CHAPTER "CONSOLE" "" "LIBRARIES" ${ARGN})

    get_filename_component(directory "${CMAKE_CURRENT_SOURCE_DIR}" NAME)

    if (NOT directory MATCHES "^([0-9]+)-(.+)$")
        message(FATAL_ERROR "learneacp_add_chapter: '${directory}' is not NN-Name")
    endif ()

    math(EXPR number "${CMAKE_MATCH_1}")
    set(target "${CMAKE_MATCH_2}")

    # The title is the README's heading without its number: "# 01. Hello Window".
    file(STRINGS README.md heading REGEX "^# " LIMIT_COUNT 1)
    string(REGEX REPLACE "^# [0-9]+\\. " "" title "${heading}")

    eacp_add_app(${target} Main.cpp)
    target_link_libraries(${target} PRIVATE learneacp-chapter ${CHAPTER_LIBRARIES})
    set_target_properties(${target} PROPERTIES MACOSX_BUNDLE TRUE)

    if (NOT CHAPTER_CONSOLE)
        eacp_set_gui_subsystem(${target})
    endif ()

    set_default_target_setting(${target})

    set(library "${target}Chapter")
    add_library(${library} OBJECT Main.cpp)
    target_link_libraries(${library} PUBLIC learneacp-chapter ${CHAPTER_LIBRARIES})
    target_compile_definitions(${library} PRIVATE
            LEARNEACP_CHAPTER_REGISTRY
            LEARNEACP_CHAPTER_NUMBER=${number}
            LEARNEACP_CHAPTER_NAME="${target}"
            LEARNEACP_CHAPTER_TITLE="${title}")
    set_default_warnings_level(${library})

    # What learneacp_embed_chapter_sources() reads back.
    set_target_properties(${library} PROPERTIES
            LEARNEACP_CHAPTER_NAME "${target}"
            LEARNEACP_CHAPTER_SOURCE "${CMAKE_CURRENT_SOURCE_DIR}/Main.cpp")

    set_property(GLOBAL APPEND PROPERTY LEARNEACP_CHAPTER_LIBRARIES ${library})
endfunction()

# learneacp_embed_chapter_sources(<target>)
#
# Compiles every chapter's Main.cpp into <target> as data, and defines
# LearnEACP::findChapterSource() (Lib/LearnEACP/ChapterSource.h) to look one up
# by chapter name. Call it after Tutorials/ has been added.
#
# Each Main.cpp becomes <Name>Source.cpp through a build step running
# EmbedSource.cmake, so editing a chapter regenerates its listing on the next
# build. The lookup table is written at configure time, since the set of
# chapters only changes when the CMake files do.
function(learneacp_embed_chapter_sources target)
    get_property(libraries GLOBAL PROPERTY LEARNEACP_CHAPTER_LIBRARIES)

    set(directory "${CMAKE_CURRENT_BINARY_DIR}/${target}-chapter-sources")
    set(script "${LEARNEACP_CMAKE_DIR}/EmbedSource.cmake")
    get_filename_component(root "${LEARNEACP_CMAKE_DIR}" DIRECTORY)

    set(generated "")
    set(declarations "")
    set(entries "")

    foreach (library IN LISTS libraries)
        get_target_property(name ${library} LEARNEACP_CHAPTER_NAME)
        get_target_property(source ${library} LEARNEACP_CHAPTER_SOURCE)
        file(RELATIVE_PATH displayPath "${root}" "${source}")

        set(output "${directory}/${name}Source.cpp")

        add_custom_command(
                OUTPUT "${output}"
                COMMAND ${CMAKE_COMMAND}
                        -DINPUT=${source}
                        -DOUTPUT=${output}
                        -DNAME=${name}
                        -DDISPLAY_PATH=${displayPath}
                        -P "${script}"
                DEPENDS "${source}" "${script}"
                COMMENT "Embedding ${displayPath}"
                VERBATIM)

        list(APPEND generated "${output}")
        string(APPEND declarations "extern const ChapterSource ${name}Source;\n")
        string(APPEND entries "        {\"${name}\", &EmbeddedSources::${name}Source},\n")
    endforeach ()

    file(CONFIGURE OUTPUT "${directory}/ChapterSources.cpp" CONTENT [=[
// Generated by learneacp_embed_chapter_sources() in CMake/LearnEACP.cmake.
#include <LearnEACP/ChapterSource.h>

#include <utility>

namespace LearnEACP
{
namespace EmbeddedSources
{
@declarations@} // namespace EmbeddedSources

const ChapterSource* findChapterSource(std::string_view name)
{
    static constexpr std::pair<std::string_view, const ChapterSource*> sources[] = {
@entries@    };

    for (const auto& [chapter, source]: sources)
        if (chapter == name)
            return source;

    return nullptr;
}
} // namespace LearnEACP
]=] @ONLY)

    target_sources(${target} PRIVATE ${generated} "${directory}/ChapterSources.cpp")
    target_link_libraries(${target} PRIVATE learneacp-chapter)
endfunction()
